# ---------------------------------------------------------------------------
# Velvet — environment configuration
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# ── YouTube Data API v3 ────────────────────────────────────────────────────
# Server-side ONLY. This value is never sent to the browser: every YouTube call
# is made from our /api/youtube/* proxy routes.
# Get one at https://console.cloud.google.com → APIs & Services → Credentials
# (enable "YouTube Data API v3" first, then create an API key and restrict it).
YOUTUBE_API_KEY=

# Default region + language for feeds (ISO 3166-1 alpha-2 / ISO 639-1).
YOUTUBE_REGION_CODE=US
YOUTUBE_RELEVANCE_LANGUAGE=en

# ── Quota governor ─────────────────────────────────────────────────────────
# YouTube grants 10,000 units/day by default. search.list costs 100 units per
# call, videos.list / channels.list / playlistItems.list cost 1 unit each.
# The app refuses to spend beyond DAILY_BUDGET and serves cache/fallback instead.
YOUTUBE_DAILY_QUOTA_BUDGET=9000
# Hard ceiling on how many units a single request may spend (defence in depth).
YOUTUBE_MAX_UNITS_PER_REQUEST=110
# Set to "false" to forbid the expensive tag-similarity search on watch pages.
ALLOW_SEARCH_FOR_RELATED=true

# ── Cache ──────────────────────────────────────────────────────────────────
# Driver: "memory" (default, per-instance LRU) | "upstash" | "vercel-kv"
CACHE_DRIVER=memory
# Max entries kept by the in-memory driver.
CACHE_MEMORY_MAX_ENTRIES=500
# TTLs in seconds (10–30 min is the sweet spot for staying inside quota).
CACHE_TTL_SEARCH=1800
CACHE_TTL_TRENDING=900
CACHE_TTL_VIDEO=1800
CACHE_TTL_CHANNEL=3600
CACHE_TTL_STATIC=86400
# How long a stale entry may still be served while a refresh fails (seconds).
CACHE_STALE_GRACE=86400

# Upstash Redis (works on any host, REST based — no extra dependency)
# https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV (auto-injected when you attach a KV store in the Vercel dashboard)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── App ────────────────────────────────────────────────────────────────────
# Public base URL, used for absolute URLs in metadata / og tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Velvet

# ── Tube (scraped video feed) ──────────────────────────────────────────────
# Admin panel login — CHANGE THIS before any public deployment.
ADMIN_PASSWORD=admin123
# Protects GET /api/cron/sync from unauthorized calls.
CRON_SECRET=dev-cron-key
# In-process auto-sync scheduler (minutes). 0 disables it; the admin panel's
# "Sync now" button and the cron endpoint always work regardless.
AUTO_SYNC_INTERVAL_MINUTES=120
